// GIGZO TFT PDK - IGZO LVS Rule Module (SVRF)
// Extracted from the supplied CMOS/IGZO Calibre LVS deck, 2026-11.
// IGZO-specific layer declarations, derivations, connectivity and device definitions ONLY.
//
// INTEGRATION NOTES:
// - Include this module in an existing CMOS LVS deck; it is NOT standalone.
// - The parent deck must define and map MET3 and supply the common LVS setup.
// - Do not keep duplicate IGZO layer/device definitions in the parent deck.
// - GDS mappings for IGZO_SD_PIN, IGZO_VIA3 and IGZO pin text require verification.
// - Device extraction, W/L values, capacitor terminals and capacitance
//   density have NOT been independently validated.

// === IGZO INPUT LAYERS ===
LAYER MAP 138 DATATYPE 0 100138
LAYER IGZO_SEMI 100138
LAYER MAP 139 DATATYPE 0 100139
LAYER IGZO_SD 100139
LAYER MAP 140 DATATYPE 0 100140
LAYER IGZO_GATE 100140
LAYER MAP 141 DATATYPE 251 100141
LAYER IGZO_GATE_PIN 100141
LAYER MAP 142 DATATYPE 0 100142
LAYER IGZO_VIA1 100142
LAYER MAP 143 DATATYPE 0 100143
LAYER IGZO_VIA2 100143
LAYER MAP 144 DATATYPE 0 100144
LAYER IGZO_SD_PIN 100144
LAYER MAP 145 DATATYPE 0 100145
LAYER IGZO_VIA3 100145
LAYER MAP 146 DATATYPE 0 100146
LAYER IGZO_MIM 100146

// === IGZO DEVICE DERIVATION AND CONNECTIVITY ===
IGZO_ACTIVE = IGZO_SEMI NOT IGZO_MIM
IGZO_CHANNEL_0 = IGZO_ACTIVE AND IGZO_GATE
IGZO_CHANNEL = IGZO_CHANNEL_0 NOT IGZO_SD
IGZO_TFT_G = COPY IGZO_CHANNEL
IGZO_TFT_SD = IGZO_ACTIVE NOT IGZO_CHANNEL
IGZO_SD_CONTACT = IGZO_TFT_SD AND IGZO_SD
IGZO_CAP_0 = IGZO_MIM AND IGZO_GATE
IGZO_CAP = IGZO_CAP_0 AND IGZO_SD

CONNECT MET3 IGZO_GATE BY IGZO_VIA1
CONNECT IGZO_GATE IGZO_SD BY IGZO_VIA2
CONNECT IGZO_TFT_G IGZO_GATE
CONNECT IGZO_TFT_SD IGZO_SD BY IGZO_SD_CONTACT

// === IGZO DEVICES AND PROPERTY EXTRACTION ===
DEVICE MN(nch) IGZO_CHANNEL IGZO_TFT_G(G) IGZO_TFT_SD(S) IGZO_TFT_SD(D)
[PROPERTY W, L
W = PERIMETER_COINCIDE(IGZO_CHANNEL, IGZO_TFT_SD)/2
L = AREA(IGZO_CHANNEL)/W
]
TRACE PROPERTY MN(nch) W W 0
TRACE PROPERTY MN(nch) L L 0

// Assumes SD=TOP/POS and GATE=BOT/NEG; density 0.0045 F/m^2.
DEVICE C(igzo_mim) IGZO_CAP IGZO_SD(POS) IGZO_GATE(NEG)
[PROPERTY C
C = 0.0045 * AREA(IGZO_CAP)
]
TRACE PROPERTY C(igzo_mim) C C 1e-15 ABSOLUTE
