// ============================================================================
// GIGZO TFT PDK - IGZO DRC Rule Module (Calibre SVRF)
// Revision: 2026-11-04 | Status: RESEARCH DRAFT 
// ============================================================================
// Purpose: IGZO-specific layer mapping, derived layers, and DRC checks.
// This is NOT a standalone Calibre rule deck. INCLUDE it in a licensed,
// compatible CMOS Calibre DRC environment after confirming its layer map.
//
// Parent rule deck must provide:
//   - MET3O: CMOS Metal-3 drawing layer (existing CMOS layer identifier).
//   - Layout input, top cell, results database, and run configuration.
//   - Compatible unit/precision settings and any required CMOS definitions.
//
// Excluded from this reusable module: personal LAYOUT PATH, LAYOUT PRIMARY,
// LAYOUT SYSTEM, and DRC RESULTS DATABASE. Configure these in the parent deck.
// ============================================================================

// --- IGZO INPUT LAYER MAP (VERIFY AGAINST TARGET GDS BEFORE USE) ------------
// Syntax: LAYER MAP <GDS layer> DATATYPE <datatype> <private Calibre layer ID>
// Private Calibre IDs are not OpenAccess/GDS layer identifiers.
LAYER MAP 138 DATATYPE 0 100138
LAYER IGZO_SEMI 100138
LAYER MAP 139 DATATYPE 0 100139
LAYER IGZO_SD 100139
LAYER MAP 140 DATATYPE 0 100140
LAYER IGZO_GATE 100140
LAYER MAP 141 DATATYPE 251 100141
LAYER IGZO_GATE_PIN 100141
LAYER MAP 142 DATATYPE 0 100142
LAYER IGZO_VIA1 100142
LAYER MAP 143 DATATYPE 0 100143
LAYER IGZO_VIA2 100143
#IFDEF IGZO_ENABLE_VIA3
LAYER MAP 145 DATATYPE 0 100145
LAYER IGZO_VIA3 100145
#ENDIF

// --- DERIVED LAYERS ----------------------------------------------------------
IGZO_CH_OPEN = IGZO_SEMI NOT IGZO_SD
IGZO_CH = IGZO_CH_OPEN INTERACT IGZO_GATE
IGZO_CH_RECT = RECTANGLE IGZO_CH
IGZO_CH_W_EDGE = COINCIDENT EDGE IGZO_CH_RECT IGZO_SD
IGZO_CH_L_EDGE = COINCIDENT EDGE IGZO_CH_RECT IGZO_SEMI
IGZO_CH_W_H = ANGLE IGZO_CH_W_EDGE == 0
IGZO_CH_W_V = ANGLE IGZO_CH_W_EDGE == 90
IGZO_CH_H = IGZO_CH_RECT WITH EDGE IGZO_CH_W_H
IGZO_CH_V = IGZO_CH_RECT WITH EDGE IGZO_CH_W_V
IGZO_SEMI_H = IGZO_SEMI INTERACT IGZO_CH_H
IGZO_SEMI_V = IGZO_SEMI INTERACT IGZO_CH_V

IGZO_GATE_NARROW = INTERNAL IGZO_GATE < 1.0 REGION OPPOSITE
IGZO_GATE_NARROW_TFT = IGZO_GATE_NARROW INTERACT IGZO_SEMI
IGZO_GATE_EXIT_EDGE = INSIDE EDGE IGZO_SEMI IGZO_GATE
IGZO_GATE_EXIT_ZONE = EXPAND EDGE IGZO_GATE_EXIT_EDGE OUTSIDE BY 2.0

// --- IGZO_VIA1 (MET3O <-> IGZO_GATE) ----------------------------------------
IGZO_VIA1_1 {
    NOT RECTANGLE IGZO_VIA1 == 1.0 BY == 1.0
}
IGZO_VIA1_2 {
    EXTERNAL IGZO_VIA1 < 1.0 REGION SINGULAR ABUT<90
}
IGZO_VIA1_3 {
    IGZO_VIA1 NOT MET3O
    ENCLOSURE IGZO_VIA1 MET3O < 0.5 REGION SINGULAR ABUT<90
}

// --- IGZO_VIA2 (IGZO_GATE <-> IGZO_SD) --------------------------------------
IGZO_VIA2_1 {
    NOT RECTANGLE IGZO_VIA2 == 1.5 BY == 1.5
}
IGZO_VIA2_2 {
    EXTERNAL IGZO_VIA2 < 1.5 REGION SINGULAR ABUT<90
}
IGZO_VIA2_3 {
    IGZO_VIA2 NOT IGZO_GATE
    ENCLOSURE IGZO_VIA2 IGZO_GATE < 0.5 REGION SINGULAR ABUT<90
}
IGZO_VIA2_4 {
    EXTERNAL IGZO_VIA1 IGZO_VIA2 < 1.0 REGION ABUT == 0
}

#IFDEF IGZO_ENABLE_VIA2_SD_ENC
IGZO_VIA2_ENC_SD {
    IGZO_VIA2 NOT IGZO_SD
    ENCLOSURE IGZO_VIA2 IGZO_SD < 0.5 REGION SINGULAR ABUT<90
}
#ENDIF

// --- IGZO_GATE ---------------------------------------------------------------
IGZO_GATE_1 {
    A = IGZO_GATE_NARROW NOT IGZO_GATE_NARROW_TFT
    A NOT IGZO_SEMI
    B = INTERNAL IGZO_GATE < 1.0 REGION OPPOSITE
    B NOT IGZO_SEMI
}
IGZO_GATE_2 {
    EXTERNAL IGZO_GATE < 1.0 REGION SINGULAR ABUT<90
}
IGZO_GATE_3 {
    IGZO_CH NOT IGZO_GATE
    ENCLOSURE IGZO_CH_W_EDGE IGZO_GATE < 0.5 REGION OPPOSITE ABUT == 0
}
IGZO_GATE_4 {
    ENCLOSURE IGZO_CH_L_EDGE IGZO_GATE < 0.5 REGION OPPOSITE ABUT == 0
}
IGZO_GATE_5 {
    EXTERNAL IGZO_GATE IGZO_SD < 0.5 REGION ABUT == 0
}
IGZO_GATE_6 {
    IGZO_VIA1 NOT IGZO_GATE
    ENCLOSURE IGZO_VIA1 IGZO_GATE < 0.5 REGION SINGULAR ABUT<90
}
IGZO_GATE_7 {
    A = INSIDE EDGE IGZO_GATE IGZO_SEMI
    INTERNAL A < 1.0 REGION OPPOSITE ABUT<90
}
IGZO_GATE_8 {
    A = IGZO_GATE_NARROW_TFT NOT IGZO_SEMI
    A NOT IGZO_GATE_EXIT_ZONE
}

// --- IGZO_SD -----------------------------------------------------------------
IGZO_SD_1 {
    INTERNAL IGZO_SD < 1.0 REGION SINGULAR ABUT<90
}
IGZO_SD_2 {
    A = EXTERNAL IGZO_SD < 1.0 REGION SINGULAR ABUT<90
    A NOT IGZO_CH
}
IGZO_SD_3 {
    A = INSIDE EDGE IGZO_SD IGZO_SEMI
    B = INSIDE EDGE IGZO_SEMI IGZO_SD
    INTERNAL A B < 0.75 REGION OPPOSITE
}
IGZO_SD_4 {
    A = INSIDE EDGE IGZO_SEMI_H IGZO_SD
    B = ANGLE A == 90
    C = INSIDE EDGE IGZO_SEMI_V IGZO_SD
    D = ANGLE C == 0
    ENCLOSURE B IGZO_SD < 0.5 REGION OPPOSITE ABUT == 0
    ENCLOSURE D IGZO_SD < 0.5 REGION OPPOSITE ABUT == 0
}
IGZO_SD_5 {
    EXTERNAL IGZO_SD IGZO_SEMI < 0.5 REGION ABUT == 0
}
IGZO_SD_6 {
    RECTANGLE IGZO_SD == 1.0 BY > 200.0
}

// --- IGZO_SEMI / CHANNEL -----------------------------------------------------
IGZO_SEMI_W_1 {
    LENGTH IGZO_CH_W_EDGE < 1.0
}
IGZO_SEMI_W_2 {
    LENGTH IGZO_CH_W_EDGE > 40.0
}
IGZO_SEMI_L_1 {
    LENGTH IGZO_CH_L_EDGE < 1.0
}
IGZO_SEMI_L_2 {
    LENGTH IGZO_CH_L_EDGE > 800.0
}
IGZO_SEMI_SP_1 {
    EXTERNAL IGZO_SEMI < 1.0 REGION SINGULAR ABUT<90
}
IGZO_SEMI_G_1 {
    IGZO_SEMI INTERACT IGZO_CH > 1
}
IGZO_SEMI_G_2 {
    NOT RECTANGLE IGZO_CH
}
IGZO_SEMI_G_3 {
    ANGLE IGZO_SEMI == 45
}

// --- OPTIONAL IGZO_VIA3 (MET3O <-> IGZO_SEMI) -------------------------------
#IFDEF IGZO_ENABLE_VIA3
IGZO_VIA3_1 {
    NOT RECTANGLE IGZO_VIA3 == 1.5 BY == 1.5
}
IGZO_VIA3_2 {
    EXTERNAL IGZO_VIA3 < 1.5 REGION SINGULAR ABUT<90
}
IGZO_VIA3_3 {
    IGZO_VIA3 NOT MET3O
    ENCLOSURE IGZO_VIA3 MET3O < 0.5 REGION SINGULAR ABUT<90
}
IGZO_VIA3_4 {
    IGZO_VIA3 NOT IGZO_SEMI
    ENCLOSURE IGZO_VIA3 IGZO_SEMI < 1.0 REGION SINGULAR ABUT<90
}
#ENDIF

// --- OPTIONAL DEBUG LAYERS ---------------------------------------------------
#IFDEF IGZO_DEBUG_LAYERS
IGZO_DEBUG_IGZO_SEMI { COPY IGZO_SEMI }
IGZO_DEBUG_IGZO_SD { COPY IGZO_SD }
IGZO_DEBUG_IGZO_GATE { COPY IGZO_GATE }
IGZO_DEBUG_IGZO_GATE_PIN { COPY IGZO_GATE_PIN }
IGZO_DEBUG_IGZO_VIA1 { COPY IGZO_VIA1 }
IGZO_DEBUG_IGZO_VIA2 { COPY IGZO_VIA2 }
#IFDEF IGZO_ENABLE_VIA3
IGZO_DEBUG_IGZO_VIA3 { COPY IGZO_VIA3 }
#ENDIF
IGZO_DEBUG_MET3O { COPY MET3O }
IGZO_DEBUG_GATE_EXIT_ZONE { COPY IGZO_GATE_EXIT_ZONE }
IGZO_DEBUG_CHANNEL { COPY IGZO_CH }
IGZO_DEBUG_CHANNEL_W { COPY IGZO_CH_W_EDGE }
IGZO_DEBUG_CHANNEL_L { COPY IGZO_CH_L_EDGE }
#ENDIF

// END OF IGZO DRC RULE MODULE
